# ─────────────────────────────────────────────────────────────────
# THE PARKS SPLASH WATER PARK PARTY — environment configuration
#
# Copy to .env for local work:  cp .env.example .env
# On Vercel, add the same keys under Project → Settings → Environment
# Variables. NEVER commit a filled-in .env. This file holds no real
# credentials and never should.
# ─────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL. Use the DIRECT (non-pooled) connection string: the seat
# allocation runs interactive transactions with SELECT ... FOR UPDATE,
# which is what makes the 55 cap race-proof, and transaction-mode
# poolers (PgBouncer, Supabase port 6543) interfere with those.
# Neon: the "Direct connection" string. Supabase: port 5432, not 6543.
# Must end with ?sslmode=require for most hosted providers.
DATABASE_URL="postgresql://user:password@host:5432/parks_splash?sslmode=require"

# ── Site ─────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Must be your real HTTPS domain in
# production — PayFast posts its notification back to it, and the ticket
# and email links are built from it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Secrets ──────────────────────────────────────────────────────
# Generate each one separately:  openssl rand -hex 32
SESSION_SECRET=""          # signs organiser session cookies
TICKET_SIGNING_SECRET=""   # signs QR ticket tokens — must differ from the above
CRON_SECRET=""             # protects /api/cron/release-expired

# ── First organiser account (used by `npm run seed`) ─────────────
# Only read at seed time. You can leave these out of Vercel entirely and
# create organisers with: npm run admin:create -- <email> <password> <name>
ADMIN_EMAIL=""
ADMIN_PASSWORD=""          # 10 characters minimum
ADMIN_NAME="Event Organizer"

# ── Payments ─────────────────────────────────────────────────────
# payfast → real PayFast checkout (sandbox or live, see PAYFAST_MODE)
# mock    → local sandbox screen, no credentials needed. Refuses to run
#           when NODE_ENV=production, so it is safe to leave here.
PAYMENT_PROVIDER="payfast"

# sandbox → https://sandbox.payfast.co.za, test money only
# live    → https://www.payfast.co.za, real money
PAYFAST_MODE="sandbox"

# PayFast's own published sandbox credentials are 10000100 / 46f0cd694581a.
# They are public test values, not secrets — but put YOUR live credentials
# in Vercel only, never in this file and never in Git.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""      # leave empty if you have not set one in PayFast

# ── Email ────────────────────────────────────────────────────────
# test → nothing is sent; messages are logged to the console and the
#        EmailLog table. live → actually sends.
EMAIL_MODE="test"
EMAIL_PROVIDER="resend"    # resend | sendgrid
EMAIL_API_KEY=""
EMAIL_FROM="The Parks Splash <tickets@yourdomain.co.za>"
EMAIL_REPLY_TO="organizer@yourdomain.co.za"

# ── Event tuning ─────────────────────────────────────────────────
# Minutes a seat is held while the guest completes payment.
RESERVATION_HOLD_MINUTES="15"

# ── Local testing only ───────────────────────────────────────────
# Where `npm run verify` points. Never needed on Vercel.
VERIFY_BASE_URL="http://localhost:3000"
